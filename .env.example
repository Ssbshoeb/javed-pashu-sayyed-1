# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is refused by .htaccess and
# must never be committed or left readable — it holds the mailbox password.
# ---------------------------------------------------------------------------

# `production` hides errors and turns on the warnings about a misconfigured
# mailer. Use `local` while developing.
APP_ENV=production
APP_DEBUG=false

# The site's own absolute origin, without a trailing slash. Used for canonical
# URLs, og:url, the sitemap and the JSON-LD @id values.
#
# The application falls back to the host of the request when this is unset, so
# the site still works — but set it, because it is what makes the canonical URL
# the same one whether the visitor arrived on www or not.
SITE_URL=https://javedpashusayyed.com

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# MAIL_MAILER=log writes each message to storage/logs instead of sending it, so
# a fresh checkout runs with no credentials. It must NEVER be left as `log` in
# production: submissions would be accepted, the visitor shown a reference
# number, and nothing delivered to the chamber. The app shouts about this in the
# log if it happens, but set it properly instead.
MAIL_MAILER=smtp

MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
# `smtps` for implicit TLS (port 465); leave empty for STARTTLS (usually 587).
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be the authenticated mailbox above, or the message fails SPF/DKIM
# alignment at the receiving end and is filed as spam.
MAIL_FROM_ADDRESS="admin@javedpashusayyed.com"
MAIL_FROM_NAME="Adv. Javed Pashu Sayyed"
# Seconds to wait on the SMTP socket.
MAIL_TIMEOUT=20

# Where every enquiry, upload and appointment request is delivered. Leave unset
# to use the chamber address in app/config/practice.php; set it on staging so a
# test submission does not reach the advocate.
# NOTIFY_EMAIL=

# Timezone the "Received" line on notification emails is stamped in, and the one
# the appointment form's "tomorrow" boundary is computed in.
SITE_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
# Leave empty to ship no analytics at all: with no value nothing is emitted, no
# request reaches Google, and the Content-Security-Policy stays tightened.
# Analytics still only starts once the visitor accepts the cookie banner.
GA4_MEASUREMENT_ID=
