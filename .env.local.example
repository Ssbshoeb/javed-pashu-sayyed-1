# Local development: copy over .env while working on the site.
#
#   php -S localhost:8000 router.php
#
APP_ENV=local
APP_DEBUG=true

SITE_URL=http://localhost:8000

# `log` writes each message to storage/logs/app-YYYY-MM.log instead of sending
# it, so the forms can be exercised end to end with no credentials and nothing
# reaching the chamber.
MAIL_MAILER=log

SITE_TIMEZONE=Asia/Kolkata

GA4_MEASUREMENT_ID=
